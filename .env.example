# ==============================================================================
# Pehchan Unisex Salon & Beauty Parlour - Environment Configuration
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security & JWT
SECRET_KEY=pehchan-luxury-salon-ultra-secure-jwt-key-2026#supersecret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to local high-performance SQLite database if PostgreSQL/Supabase is not configured
DATABASE_URL=sqlite:///./backend/app/pehchan_salon.db

# Optional Supabase Direct Integration (Production)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Salon Owner / Admin Default Credentials
ADMIN_DEFAULT_EMAIL=admin@pehchansalon.com
ADMIN_DEFAULT_PASSWORD=AdminPehchan@2026

# WhatsApp Business Cloud API Integration
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_SALON_NOTIFICATION_NUMBER=+919876543210

# Email Notification Service (SMTP)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bookings@pehchansalon.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL="Pehchan Unisex Salon <bookings@pehchansalon.com>"
SALON_NOTIFICATION_EMAIL=owner@pehchansalon.com

# Google Maps API Key (Optional, falls back to direct embed URL)
GOOGLE_MAPS_EMBED_QUERY=Pehchan+Unisex+Salon
